# Railway version of nginx.conf (no SSL: Railway terminates HTTPS).
# ${PORT}, ${FRONTEND_HOST} and ${BACKEND_HOST} are filled in at startup.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Railway's edge talks HTTP to us; keep the original https scheme
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen ${PORT};
  listen [::]:${PORT};
  client_max_body_size 5m;

  location / {
    proxy_pass http://${FRONTEND_HOST}:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_cache_bypass $http_upgrade;
  }

  # Public API keeps the /api prefix
  location /api/public/ {
    proxy_pass http://${BACKEND_HOST}:3001;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  # Everything else under /api/ is stripped of the prefix
  location /api/ {
    proxy_pass http://${BACKEND_HOST}:3001/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 86400s;
  }

  location /socket.io/ {
    proxy_pass http://${BACKEND_HOST}:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_buffering off;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /uploads/ {
    proxy_pass http://${BACKEND_HOST}:3001/uploads/;
  }
}
